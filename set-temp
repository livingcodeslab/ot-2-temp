#!/usr/bin/env bash
# Convenience wrapper so you can type:  ./set-temp 30
# A bare number is treated as "set <C>", so both of these work:
#   ./set-temp 30
#   ./set-temp set 30 --no-wait
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

if [[ "${1:-}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    set -- set "$@"
fi
exec python3 -m tempdeck "$@"
